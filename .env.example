# Скопируйте в .env и заполните только то, что используете. Файл .env в git не попадает.

# --- Ollama (обязательно) ---------------------------------------------------
# Локальный демон Ollama: https://ollama.com/download . Облачные модели (*-cloud)
# работают через него после `ollama signin`. Облачные модели платные: токены по прайсу (Pay as you go)
# или подписка Pro $20/мес ($60 кредитов), Max $100/мес. Демо по записанным ответам (`demo --replay`) — бесплатно.
OLLAMA_HOST=http://127.0.0.1:11434

# Прямой доступ к Ollama Cloud API без локального демона (опционально).
# Ключ: https://ollama.com/settings/keys ; тогда OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# --- decide(): модель решений -------------------------------------------------
# По умолчанию — Clef через System One API локального демона Ollama (`clef:cloud`, без ключа,
# оплачивается кредитами Ollama: $0.24 за 1 млн входных токенов). Варианты: systemone | jev | llm.
STRATEGIST_DECIDE_BACKEND=systemone
# Jev (TypeSafe) — тот же протокол System One; нативный API по листу ожидания: https://typesafe.ai
# Платно: ~$0.042 за 1 млн входных токенов (заявление вендора). Проверен 05.11 (TASK-3): 86,8% на русском
# наборе против 97,4% у Clef; для профиля jev задайте порог эскалации 0,8 (evals/spikes/decide/REPORT.md).
# Через OpenRouter decide() недоступен: там только чат-маршрутизатор typesafe/jev-router.
TYPESAFE_API_KEY=

# --- Прочее -----------------------------------------------------------------
# Каталог кейсов (по умолчанию ./cases)
STRATEGIST_CASES_DIR=
